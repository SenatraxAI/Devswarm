# DevSwarm Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED - Core AI Model
# ============================================
# Already configured via Ollama (no key needed)

# ============================================
# OPTIONAL - Tool API Keys
# ============================================

# Tavily Search API (for web research tool)
# Get free key: https://tavily.com
# Without this: web_search tool won't work (other 21 tools work fine)
TAVILY_API_KEY=

# Snyk Security Scanner (for dependency vulnerability scanning)
# Get free key: https://snyk.io
# Without this: scan_dependencies tool won't work (other 21 tools work fine)
SNYK_TOKEN=

# ============================================
# Tool Status Summary
# ============================================
# Total Tools: 22
# Work without keys: 20 tools
# Need API keys: 2 tools (Tavily, Snyk)
# 
# The system works fully without these keys!
# You'll just get clear error messages if agents try to use those 2 tools.
